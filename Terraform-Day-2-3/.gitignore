# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*


# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files
*.tfvars
*.tfvars.json

# Keep these because they currently contain non-sensitive configuration
!dev.tfvars
!stage.tfvars

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Private keys and certificates
*.pem
*.ppk
*.key
*.crt

# Environment / secret files
.env
.env.*

# VS Code
.vscode/

# Other IDE files
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
